{
  "name": "banner-settings-app",
  "version": "0.0.0",
  "scripts": {
    "clean": "rimraf ./dist",
    "lockfile:public": "npm install --package-lock-only --registry=https://registry.npmjs.org",
    "lockfile:proxy": "npx -y npm@10.9.9 install --package-lock-only --registry=https://packagefeedproxy.microsoft.io/npm/ --replace-registry-host=never",
    "install:public": "npm install --registry=https://registry.npmjs.org",
    "compile": "npm run clean && webpack --mode production",
    "compile:dev": "npm run clean && webpack --mode development",
    "build:dev": "npm run compile:dev",
    "package:dev": "npm run package:vsts-extension --vssconfig=dev",
    "publish:dev": "npm run publish:vsts-extension --vssconfig=dev",
    "build:ppe": "npm run compile",
    "package:ppe": "npm run package:vsts-extension --vssconfig=ppe",
    "publish:ppe": "npm run publish:vsts-extension --vssconfig=ppe",
    "build:release": "npm run compile",
    "package:release": "npm run package:vsts-extension --vssconfig=release",
    "publish:release": "npm run publish:vsts-extension --vssconfig=release",
    "package:vsts-extension": "tfx extension create --manifests ./azure-devops-extension.json --overrides-file ./configs/%npm_config_vssconfig%.json",
    "publish:vsts-extension": "tfx extension publish --manifests ./azure-devops-extension.json --overrides-file ./configs/%npm_config_vssconfig%.json",
    "dev": "webpack-dev-server --hot --progress --static-directory ./ --server-type https --port 44405",
    "lint": "tslint --project ."
  },
  "dependencies": {
    "azure-devops-extension-api": "~1.157.0",
    "azure-devops-extension-sdk": "~2.0.10",
    "azure-devops-ui": "~2.272.0",
    "moment": "~2.24.0",
    "react": "~16.9.0",
    "react-dom": "~16.9.0",
    "text-mask-core": "~5.1.2"
  },
  "devDependencies": {
    "@types/react": "~16.9.0",
    "@types/react-dom": "~16.9.0",
    "base64-inline-loader": "^2.0.1",
    "copy-webpack-plugin": "^4.6.0",
    "css-loader": "~7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "file-loader": "~6.2.0",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "~1.77.8",
    "path": "^0.12.7",
    "rimraf": "~2.6.2",
    "sass-loader": "~16.0.7",
    "style-loader": "~0.23.1",
    "tfx-cli": "~0.7.10",
    "ts-loader": "~6.0.4",
    "tslint": "^5.18.0",
    "tslint-react": "^4.0.0",
    "typescript": "^3.5.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  }
}
